# Local configuration and credentials
.env
.env.*
!.env.example
!.env.*.example

# Supplied datasets and derived data must never enter Git.
# Everything under data/ is ignored; only the directory markers are tracked.
/data/**
!/data/raw/
!/data/raw/.gitkeep
!/data/processed/
!/data/processed/.gitkeep

# Python environments and caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Node and Next.js artifacts
node_modules/
.next/
out/
*.tsbuildinfo

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
