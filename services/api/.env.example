# Copy to .env in services/api for local development, or set these in the environment.
COACHLENS_API_TITLE=CoachLens API
COACHLENS_API_SERVICE_NAME=coachlens-api
# AWS-1 is off by default. The normal provider remains privacy-blocked for real data.
# The flag also installs the AWS-3 evidence validator, the AWS-4 intervention reasoner and solution
# validator, and the AWS-5 training designer, which runs only behind the AWS-4 handoff
# (see docs/aws4-intervention-solution-validator.md and docs/aws5-training-designer.md).
COACHLENS_BEDROCK_ENABLED=false
COACHLENS_BEDROCK_REGION=us-east-1
COACHLENS_BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
