{
  "services": {
    "frontend": {
      "root": "apps/web/",
      "framework": "nextjs"
    },
    "backend": {
      "root": "services/api/",
      "entrypoint": "app.vercel_main:app"
    }
  },
  "rewrites": [
    {
      "source": "/diagnostics/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/designs/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/interventions/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
